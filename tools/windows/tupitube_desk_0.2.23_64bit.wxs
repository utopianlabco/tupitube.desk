						<RegistryValue Root="HKLM" Key="SOFTWARE\MyApp\Capabilities\shell\Open\command" Value="&quot;[APPLICATIONFOLDER]TUPITUBE.DESK.EXE&quot; &quot;%1&quot;" Type="string" />
						<RegistryValue Root="HKLM" Key="SOFTWARE\RegisteredApplications" Name="TUPITUBE.DESK" Value="SOFTWARE\TUPITUBE.DESK\Capabilities" Type="string" />

						<ProgId Id="TupFile" Description="TupiTube Source File" Icon="DesktopIcon.exe" Advertise="yes">
